<?xml version="1.0"?>
<ruleset name="StatusLights">
    <description>Coding standard for Status Lights</description>

    <!-- The project deliberately uses global PHP symbols in cohesive, dependency-free scripts. -->
    <rule ref="PSR12">
        <exclude name="PSR1.Classes.ClassDeclaration.MissingNamespace"/>
        <exclude name="PSR1.Classes.ClassDeclaration.MultipleClasses"/>
        <exclude name="PSR1.Files.SideEffects.FoundWithSymbols"/>
    </rule>

    <!-- Request/response literals and compact fixtures make a fixed line width counterproductive. -->
    <rule ref="Generic.Files.LineLength">
        <properties>
            <property name="lineLimit" value="0"/>
            <property name="absoluteLineLimit" value="0"/>
        </properties>
    </rule>

    <file>generator</file>
    <file>scripts</file>

    <exclude-pattern>*/app-data/*</exclude-pattern>
    <exclude-pattern>*/cache/*</exclude-pattern>
</ruleset>
